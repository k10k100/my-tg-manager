# ════════════════════════════════════════════════════════════════════
#  مثال على ملف متغيرات البيئة — انسخ هذا الملف وسمّه .env
#  ثم ضع القيم الحقيقية فيه. لا ترفع ملف .env على GitHub أبداً!
# ════════════════════════════════════════════════════════════════════

# ─── Telegram Bot ────────────────────────────────────────────────────
# توكن البوت — احصل عليه من @BotFather على تيليجرام
BOT_TOKEN=6257658562:AAHlnOdAGiKomszzyqIOyK9MlTMjac_VwuI
# معرّف حسابك الشخصي على تيليجرام — ستحصل عليه من @userinfobot
ADMIN_ID=1995454152

# ─── جلسة ويب لوحة الإدارة (اختياري) ───────────────────────────────
# سلسلة نصية عشوائية لتشفير جلسات واجهة الأدمن
SESSION_SECRET=change-me-to-a-long-random-string

# ─── قاعدة البيانات PostgreSQL (اختياري — اتركها فارغة لاستخدام JSON) ─
#
# إذا تركت DATABASE_URL فارغاً → يخزّن البوت البيانات في ملفات JSON (الافتراضي)
# إذا ضبطت DATABASE_URL        → يستخدم PostgreSQL تلقائياً
#
# عند استخدام docker compose --profile db:
#   DATABASE_URL=postgresql://botuser:changeme123@postgres/botdb
#
# عند استخدام PostgreSQL خارجي:
#   DATABASE_URL=postgresql://user:pass@host:5432/dbname
#
# كلمة سر قاعدة البيانات في Docker (لا تغيّرها بعد أول تشغيل!)
DATABASE_URL=
DB_PASSWORD=changeme123

# ─── إعدادات Webhook (اتركها فارغة لاستخدام Polling) ────────────────
#
# WEBHOOK_URL  : عنوان HTTPS العام لسيرفرك (بدون / في النهاية)
#                مثال: https://bot.example.com
#
# WEBHOOK_PORT : البورت الداخلي الذي يستمع عليه البوت (الافتراضي 8443)
#                nginx يعيد التوجيه من 443 إلى هذا البورت
#
# WEBHOOK_SECRET : سلسلة عشوائية للتحقق من أن الطلبات قادمة من Telegram
#                  اختياري لكن يُنصح به في الإنتاج
#
WEBHOOK_URL=
WEBHOOK_PORT=8443
WEBHOOK_SECRET=
